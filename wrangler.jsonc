{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "slopsubs",
	"compatibility_date": "2026-10-17",
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{ "pattern": "slopsubs.com", "custom_domain": true },
		{ "pattern": "www.slopsubs.com", "custom_domain": true },
		{ "pattern": "slopsubs.pnav.dev", "custom_domain": true }
	]
}
