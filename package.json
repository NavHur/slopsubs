{
  "name": "slopsubs",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "generate-routes": "tsr generate",
    "preview": "vp preview",
    "test": "vp test run",
    "typecheck": "tsrs --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "import-benchmarks": "bun scripts/import-benchmarks.ts",
    "import-aa-evals": "bun scripts/import-aa-evals.ts",
    "import-frontiercode": "bun scripts/import-frontiercode.ts",
    "measure": "node scripts/measure.ts",
    "build-plans": "node scripts/build-plans.ts",
    "render-brand-images": "vp build && node scripts/render-brand-images.ts",
    "profile-page": "vp build --minify false && node scripts/profile-page.ts",
    "deploy": "vp run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "d3-scale": "^4.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.132.0",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright-core": "1.62.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "packageManager": "bun@1.4.4"
}
